+#ifdef RIDGE3_F421
+// Murata NCU15XH103F60RC (10k, B25/50 3380 K) to ground under a 10k
+// from VDDA (the driver's DVDD): ADC = 4096 R / (R + 10k).  Entry i is
+// the temperature at ADC = 64 i, from the B equation; 0 and 64 are
+// extrapolated (the sensor is never there).
+int NTC_table[65] = {
+  239, 197, 155, 133, 119, 108, 100, 93, 87,
+  82, 77, 73, 69, 66, 63, 60, 57, 54,
+  52, 50, 47, 45, 43, 41, 39, 37, 35,
