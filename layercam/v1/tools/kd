#!/bin/sh
# Run a command inside the pinned toolchain container (tools/Dockerfile),
# with the repository mounted at /w and the working directory carried over.
#   tools/kd python3 src/make.py
ROOT=$(cd "$(dirname "$0")/../../.." && pwd)
REL=$(pwd | sed "s|^$ROOT||")
SUDO=$( [ -w /var/run/docker.sock ] || echo sudo )
exec $SUDO docker run --rm -u "$(id -u):$(id -g)" -e HOME=/tmp -e PYTHONHASHSEED=0 ${FANOUT_DEBUG:+-e FANOUT_DEBUG=$FANOUT_DEBUG} ${MITER_DEBUG:+-e MITER_DEBUG=1} ${FREEROUTING_TIMEOUT:+-e FREEROUTING_TIMEOUT=$FREEROUTING_TIMEOUT} ${PASSES:+-e PASSES=$PASSES} ${MAIN_BOARD:+-e MAIN_BOARD=$MAIN_BOARD} \
  -v "$ROOT":/w -w "/w$REL" ${KD_IMAGE:-ogkicad-layercam:1} "$@"
