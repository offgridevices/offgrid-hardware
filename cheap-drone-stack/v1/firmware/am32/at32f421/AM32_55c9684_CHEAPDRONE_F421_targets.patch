+// OffGrid Cheap Drone ESC (cheap-drone-stack/v1/esc) with the Artery
+// AT32F421K8U7 (QFN32 5x5) fitted in place of the STM32F051K6U6.  Same pins as
+// FD6288_F051 / HARDWARE_GROUP_F0_A: input PA2 (TMR15_CH1); phase A PA10/PB1,
+// B PA9/PB0, C PA8/PA7; comparators A PA5, B PA4, C PA0, neutral PA1;
+// battery voltage PA3 (11k/2k), current PA6 (MCU_AT421 defaults).
+// DEAD_TIME: FD6288_F051 uses 45 counts of 48 MHz = 937.5 ns.  TMR1 here runs
+// at 120 MHz (CLKDIV 0), so 937.5 ns = 112.5 counts; 113 = 941.7 ns (never
+// less than the F051 build).  It also keeps AM32's DEAD_TIME-based minimum
+// duty at the same fraction of the PWM period (113/5000 vs 45/2000).
+#ifdef CHEAPDRONE_F421
+#define FIRMWARE_NAME "CHEAPDRN_421"
+#define FILE_NAME "CHEAPDRONE_F421"
+#define DEAD_TIME 113
+#define HARDWARE_GROUP_AT_C
+#define HARDWARE_GROUP_AT_540
+#define TARGET_VOLTAGE_DIVIDER 65
+#define USE_SERIAL_TELEMETRY
+#endif
+
 #ifdef TBS_6S_4IN1_F421
 #define FIRMWARE_NAME "TBSlu6s4in1"
 #define FILE_NAME "TBS_6S_4IN1_F421"
