(version 1)
# JLCPCB limits the board-setup numbers cannot express on their own (the same
# for every layer count: PTH to track 0.28 mm minimum).
(rule "plated component hole to track"
  (condition "A.Type == 'Pad' && A.isPlated() && A.Pad_Type == 'Through-hole' && B.Type == 'Track'")
  (constraint hole_clearance (min 0.28mm)))
# Every plane-net pad already has its own via into the plane; one thermal
# spoke from the surface fill is enough.
(rule "one spoke is enough"
  (constraint min_resolved_spokes 1))
# JLCPCB via-in-pad (POFV): ordered "Epoxy Filled & Capped", every via is
# filled; holes drilled afterwards (the unplated mounting holes and plated
# pads) keep 0.45 mm from them.
(rule "POFV to drilled holes"
  (condition "A.Type == 'Via' && B.Type == 'Pad'")
  (constraint hole_to_hole (min 0.45mm)))

# JLCPCB's finest gap on 6 layers is 0.09 mm: the check allows it between
# tracks, vias and pads (Freerouting's necks), while the net classes keep
# 0.1 mm for the routers (pours keep their own clearances); later rules win
(rule "fab minimum clearance"
  (condition "A.Type != 'Zone' && B.Type != 'Zone'")
  (constraint clearance (min 0.09mm)))

(rule "RF coplanar gap"
  (condition "A.NetClass == 'RF' && B.Type == 'Zone'")
  (constraint clearance (min 0.25mm)))

(rule "RF gap to other nets' tracks and vias"
  (condition "A.NetClass == 'RF' && A.Type == 'Track' && (B.Type == 'Track' || B.Type == 'Via') && B.NetClass != 'RF' && B.NetName != 'GND' && !B.intersectsCourtyard('U*')")
  (constraint clearance (min 0.25mm)))
(rule "gap pad: ground vias only"
  (condition "A.Type == 'Via' && A.NetName != 'GND' && A.intersectsArea('gap pad')")
  (constraint disallow via))
(rule "USB-C locating slot (Amphenol 12401610 drawing)"
  (condition "A.Type == 'Pad' && A.memberOfFootprint('J1') && B.memberOfFootprint('J1')")
  (constraint edge_clearance (min 0.25mm)))
