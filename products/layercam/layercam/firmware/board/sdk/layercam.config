# Kernel options LayerCam needs on top of luckfox_rv1106_linux_defconfig
# (Luckfox SDK commit 824b817f).  Copy to sysdrv/source/kernel/arch/arm/configs/
# and name it in RK_KERNEL_DEFCONFIG_FRAGMENT.
#
# Wi-Fi: the SDK's out-of-tree bcmdhd (sysdrv/drv_ko/wifi/bcmdhd) builds its
# cfg80211 interface only when CONFIG_CFG80211 is set, and with
# CUSTOMER_HW_ROCKCHIP takes its power and interrupt GPIOs from the
# "wlan-platdata" node through net/rfkill/rfkill-wlan.c (RFKILL_RK).
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_RFKILL=y
CONFIG_RFKILL_RK=y
# SMB upload: mount -t cifs (NFS is already in the defconfig)
CONFIG_CIFS=y
