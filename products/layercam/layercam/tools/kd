#!/bin/sh
# Run a command inside the pinned toolchain container (tools/Dockerfile),
# with the repository mounted at /w and the working directory carried over.
#   tools/kd python3 src/make.py
# The repository root, at any folder depth.  In a git worktree the
# repository's own .git lives outside it: mount that too, at its own path,
# so git works inside the container (check_outputs.py reads HEAD).
ROOT=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
GIT=$(git -C "$ROOT" rev-parse --path-format=absolute --git-common-dir)
case "$GIT" in "$ROOT"/*) OUTSIDE= ;; *) OUTSIDE=1 ;; esac
REL=$(pwd | sed "s|^$ROOT||")
# sudo only where this user cannot reach docker (Docker Desktop has no
# /var/run/docker.sock, so testing for the socket file picked sudo there)
SUDO=$(docker info > /dev/null 2>&1 || echo sudo)
exec $SUDO docker run --rm -u "$(id -u):$(id -g)" -e HOME=/tmp -e PYTHONHASHSEED=0 ${FANOUT_DEBUG:+-e FANOUT_DEBUG=$FANOUT_DEBUG} ${MITER_DEBUG:+-e MITER_DEBUG=1} ${FREEROUTING_TIMEOUT:+-e FREEROUTING_TIMEOUT=$FREEROUTING_TIMEOUT} ${PASSES:+-e PASSES=$PASSES} ${MAIN_BOARD:+-e MAIN_BOARD=$MAIN_BOARD} ${FR_EXTRA:+-e "FR_EXTRA=$FR_EXTRA"} ${FREEROUTING2:+-e "FREEROUTING2=$FREEROUTING2"} ${FR_FANOUT:+-e FR_FANOUT=1} ${FINISH_SEED:+-e FINISH_SEED=$FINISH_SEED} ${FR_IN3:+-e FR_IN3=$FR_IN3} ${FINISH_IN3:+-e FINISH_IN3=$FINISH_IN3} ${FINISH_TIME:+-e FINISH_TIME=$FINISH_TIME} \
  -v "$ROOT":/w ${OUTSIDE:+-v} ${OUTSIDE:+"$GIT:$GIT"} -w "/w$REL" ${KD_IMAGE:-ogkicad-layercam:2} "$@"
