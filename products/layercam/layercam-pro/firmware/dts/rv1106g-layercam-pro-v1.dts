// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * OffGrid LayerCam Pro v1: RV1106G3, a bare SmartSens SC4336H and an
 * Espressif ESP32-C6-MINI-1U-H4 (esp-hosted) on one board.
 *
 * Made from LayerCam v1's tree, which follows the Luckfox SDK's
 * rv1106g-luckfox-pico-pro-max.dts (camera, flash, USB) and
 * rv1106g-luckfox-pico-ultra.dts (SDIO), commit 824b817f of
 * github.com/LuckfoxTECH/luckfox-pico.  The Wi-Fi part follows
 * esp-hosted-linux v1.0.6.0.7 (github.com/espressif/esp-hosted-linux,
 * host/overlays/esp32-sdio-pwrseq.dts, docs/porting.md); the sensor node the
 * SDK's sc4336.c and rv1106-evb-cam.dtsi.  Every pin is the one
 * src/circuit.py's main_soc() gives it; tests/test_pins.py checks this file
 * against circuit.py.  Copy it to sysdrv/source/kernel/arch/arm/boot/dts/
 * and point RK_KERNEL_DTS at it (README.md, Building the image).
 *
 * Not yet booted on a board, and never compiled with dtc.
 */

/dts-v1/;

#include "rv1106.dtsi"
#include "rv1106-evb.dtsi"

/ {
	model = "OffGrid LayerCam Pro v1";
	compatible = "offgrid,layercam-pro-v1", "rockchip,rv1106g3";

	/* as Luckfox's boards; on SPI NAND, U-Boot's environment supplies root= */
	chosen {
		bootargs = "earlycon=uart8250,mmio32,0xff4c0000 console=ttyFIQ0 rootwait snd_soc_core.prealloc_buffer_size_kbytes=16 coherent_pool=0";
	};

	/* No keys: the camera has no button.  The evb's adc-keys would poll
	 * SARADC_IN0, which here is the BOOT pad (TP5), the boot ROM's MaskROM
	 * strap, and report it as volume keys.  The camera software reads the
	 * pin only to warn when it leaks towards ground (layercam/hw.py). */
	/delete-node/ adc-keys;

	vcc_1v8: vcc-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_1v8";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
	};

	vcc_3v3: vcc-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_3v3";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
	};

	/* the 0.9 V buck is fixed (TLV62569, 0.882 V), as Luckfox's */
	vdd_arm: vdd-arm {
		compatible = "regulator-fixed";
		regulator-name = "vdd_arm";
		regulator-min-microvolt = <800000>;
		regulator-max-microvolt = <1000000>;
		regulator-init-microvolt = <900000>;
		regulator-always-on;
		regulator-boot-on;
	};

	/* LED1, green, GPIO1_C0 through 1k: /sys/class/leds/status */
	leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&status_led_pin>;

		status_led: status {
			label = "status";
			gpios = <&gpio1 RK_PC0 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};
	};

	/* ESP32-C6 EN on GPIO1_A2 (100k pull-down and 100 nF on the board: the
	 * module is held in reset until Linux raises it).  1500 ms, not v1's
	 * 200 ms: esp-hosted-linux's own overlay says the C6's SDIO function is
	 * not reliably CMD52-ready after 200 ms and qualifies 1500 ms
	 * (host/overlays/esp32-sdio-pwrseq.dts).  To flash the C6 over its UART
	 * this device is unbound so the pin is free (tools/layercam-c6-flash.py). */
	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_enable_h>;
		reset-gpios = <&gpio1 RK_PA2 GPIO_ACTIVE_LOW>;
		post-power-on-delay-ms = <1500>;
	};

	/* No wlan-platdata (bcmdhd) and no bluetooth-platdata node: the C6 is
	 * an ordinary SDIO card to esp-hosted's esp32_sdio.ko, and the board has
	 * no Bluetooth.  WIFI_HOST_WAKE (GPIO0_A3, the C6's IO4) is wired for
	 * esp-hosted's host-sleep wake-up but unused: the camera never
	 * suspends.  Its pin is set below (pull-down) and nothing claims it. */
};

&cpu0 {
	cpu-supply = <&vdd_arm>;
};

/********** flash: W25N02KV, quad SPI NAND (as the Pro Max) **********/
&sfc {
	status = "okay";
	flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		spi-max-frequency = <75000000>;
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <1>;
	};
};

/********** SDIO: ESP32-C6 (esp-hosted) at 3.3 V (VCCIO4 3.3 V) **********/
/* 25 MHz for bring-up, as esp-hosted's porting guide advises ("start with a
 * conservative bus clock"); the C6 slave does 50 MHz high speed, so raise it
 * once transfers are proven.  25 MHz x 4 bits is far more than the camera's
 * uploads need. */
&sdmmc {
	max-frequency = <25000000>;
	bus-width = <4>;
	cap-sd-highspeed;
	cap-sdio-irq;
	keep-power-in-suspend;
	non-removable;
	no-1-8-v;
	supports-sdio;
	rockchip,default-sample-phase = <90>;
	mmc-pwrseq = <&sdio_pwrseq>;
	/* esp-hosted (host/sdio/esp_sdio.c): this pwrseq really toggles the
	 * C6's EN, so an mmc_hw_reset() restarts its firmware */
	espressif,full-chip-reset;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc0_clk &sdmmc0_cmd &sdmmc0_bus4 &sdmmc0_det>;
	status = "okay";
};

/********** UART1_M0 to the C6's UART0 (TX/RX only): flashing it from Linux, /dev/ttyS1 **********/
/* rv1106.dtsi's default also takes CTS/RTS (GPIO0_A5/A6); here only the two
 * data lines are wired (esptool's protocol needs no flow control) */
&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart1m0_xfer>;
	status = "okay";
};

/********** not fitted on this board **********/
&gmac {
	status = "disabled";
};

&i2s0_8ch {
	status = "disabled";
};

&acodec {
	status = "disabled";
};

/********** USB-C: device only (the layercam-setup console, CDC-ACM) **********/
/* peripheral, not otg: the USB-C has Rd on CC and no VBUS switch, so it is
 * never a host, and with no ID pin or role switch otg could only guess.
 * MaskROM (BOOT pads) and U-Boot's loader (reboot loader) flash over the
 * same port without Linux, so nothing here affects them. */
&u2phy {
	status = "okay";
};

&u2phy_otg {
	rockchip,dis-u2-susphy;
	status = "okay";
};

&usbdrd {
	status = "okay";
};

&usbdrd_dwc3 {
	status = "okay";
	dr_mode = "peripheral";
};

&rtc {
	status = "okay";
};

/********** ADC: SARADC_IN0 BOOT pad (diagnostics only), SARADC_IN1 light sensor; 1.8 V reference **********/
&saradc {
	status = "okay";
	vref-supply = <&vcc_1v8>;
};

&tsadc {
	status = "okay";
};

/********** IR LEDs: PWM3 on its M1 pin (GPIO1_B0) to the AO3400A gate **********/
&pwm3 {
	status = "okay";
	pinctrl-names = "active";
	pinctrl-0 = <&pwm3m1_pins>;
};

/********** camera: SC4336H, 2 lanes, I2C4_M2 at 0x30, 24 MHz MCLK on GPIO3_C4, XSHUTDN GPIO3_C5, PWDNB GPIO3_C6 **********/
&csi2_dphy_hw {
	status = "okay";
};

&csi2_dphy0 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			csi_dphy_input0: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&sc4336h_out>;
				data-lanes = <1 2>;
			};
		};

		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			csi_dphy_output: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&mipi_csi2_input>;
			};
		};
	};
};

&i2c4 {
	status = "okay";
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c4m2_xfer>;

	/* SmartSens SC4336H, bare on the board (SID low: 0x30).  No driver for
	 * it exists in the SDK or in Rockchip's kernels, and its chip ID and
	 * register table are under SmartSens NDA.  "smartsens,sc4336h" is the
	 * port of the SDK's sc4336.c that tools/sc4336h-port.py makes
	 * (README.md, The sensor driver): same power sequence (24 MHz xvclk,
	 * reset = XSHUTDN, pwdn = PWDNB, both "1 = run" as Rockchip's evb
	 * writes them), same 2560x1440 2-lane mode.  TODO(SC4336H): the
	 * register table is the SC4336's until SmartSens' is in hand.
	 * The module and lens names are ours: they make rkaiq load
	 * /etc/iqfiles/sc4336h_LayerCamPro_LCP-F16.json (layercam/board.py). */
	sc4336h: sc4336h@30 {
		compatible = "smartsens,sc4336h";
		status = "okay";
		reg = <0x30>;
		clocks = <&cru MCLK_REF_MIPI0>;
		clock-names = "xvclk";
		reset-gpios = <&gpio3 RK_PC5 GPIO_ACTIVE_HIGH>;
		pwdn-gpios = <&gpio3 RK_PC6 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&mipi_refclk_out0>;
		rockchip,camera-module-index = <0>;
		rockchip,camera-module-facing = "back";
		rockchip,camera-module-name = "LayerCamPro";
		rockchip,camera-module-lens-name = "LCP-F16";
		port {
			sc4336h_out: endpoint {
				remote-endpoint = <&csi_dphy_input0>;
				data-lanes = <1 2>;
			};
		};
	};
};

&mipi0_csi2 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi_csi2_input: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&csi_dphy_output>;
			};
		};

		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi_csi2_output: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&cif_mipi_in>;
			};
		};
	};
};

&rkcif {
	status = "okay";
};

&rkcif_mipi_lvds {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&mipi_pins>;
	port {
		cif_mipi_in: endpoint {
			remote-endpoint = <&mipi_csi2_output>;
		};
	};
};

&rkcif_mipi_lvds_sditf {
	status = "okay";
	port {
		mipi_lvds_sditf: endpoint {
			remote-endpoint = <&isp_in>;
		};
	};
};

&rkisp {
	status = "okay";
};

&rkisp_vir0 {
	status = "okay";
	port@0 {
		isp_in: endpoint {
			remote-endpoint = <&mipi_lvds_sditf>;
		};
	};
};

/********** pins **********/
&pinctrl {
	/* the IR-cut H-bridge inputs (DRV8210P IN1/IN2, pulled down inside the
	 * driver too): plain GPIOs, low, so the bridge is off until the
	 * camera software pulses the coil.  Held by the pin controller itself. */
	pinctrl-names = "default";
	pinctrl-0 = <&ircut_pins &wifi_boot &wifi_host_wake>;

	ircut {
		ircut_pins: ircut-pins {
			rockchip,pins =
				/* IRCUT_A, GPIO1_A0 */
				<1 RK_PA0 RK_FUNC_GPIO &pcfg_pull_down>,
				/* IRCUT_B, GPIO1_A1 */
				<1 RK_PA1 RK_FUNC_GPIO &pcfg_pull_down>;
		};
	};

	leds {
		status_led_pin: status-led-pin {
			rockchip,pins = <1 RK_PC0 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	wifi {
		wifi_enable_h: wifi-enable-h {
			rockchip,pins = <1 RK_PA2 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		/* the C6's GPIO9 strap: high (10k on the board, and this pull-up)
		 * = boot from its flash.  A plain GPIO that no driver claims, so
		 * layercam-c6-flash can pull it low through sysfs */
		wifi_boot: wifi-boot {
			rockchip,pins = <0 RK_PA2 RK_FUNC_GPIO &pcfg_pull_up>;
		};
		/* the C6's IO4 (an MTMS strap, harmless low): unused input */
		wifi_host_wake: wifi-host-wake {
			rockchip,pins = <0 RK_PA3 RK_FUNC_GPIO &pcfg_pull_down>;
		};
	};

	/* SDMMC0_DET has 1k to ground on the board: the "card" is always there */
	sdmmc0 {
		sdmmc0_det: sdmmc0-det {
			rockchip,pins = <3 RK_PA1 1 &pcfg_pull_down>;
		};
	};
};
