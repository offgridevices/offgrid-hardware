# Kernel options LayerCam Pro needs on top of luckfox_rv1106_linux_defconfig
# (Luckfox SDK commit 824b817f).  Copy to sysdrv/source/kernel/arch/arm/configs/
# and name it in RK_KERNEL_DEFCONFIG_FRAGMENT.
#
# Wi-Fi: the ESP32-C6 runs esp-hosted firmware; its Linux driver,
# esp32_sdio.ko, is built out of tree from esp-hosted-linux's host/ against
# this kernel (README.md, Building the image).  It is a cfg80211 FullMAC
# driver (wlan0, nl80211 for wpa_supplicant and hostapd), so cfg80211 must be
# built in.  Its esp.h includes <net/bluetooth/hci_core.h> and esp_bt.c calls
# the HCI core whether or not the C6 runs Bluetooth, so the module only loads
# with the Bluetooth core in the kernel.  The board has no Bluetooth and no
# Bluetooth driver is enabled: CONFIG_BT is only the core (and the crypto it
# selects).  v1's CONFIG_RFKILL / CONFIG_RFKILL_RK were for bcmdhd's
# wlan-platdata node and are gone; without CONFIG_RFKILL=y the SDK's
# drv_ko/wifi Makefile also skips bcmdhd.
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_BT=y
#
# Sensor: the SC4336H driver, a port of the SDK's sc4336.c that
# tools/sc4336h-port.py adds to drivers/media/i2c (Kconfig entry
# VIDEO_SC4336H).  A module, like the SDK's sensors; S21appinit loads it
# before the SDK's insmod_ko.sh, which does not know it.
CONFIG_VIDEO_SC4336H=m
#
# SMB upload: mount -t cifs (NFS is already in the defconfig)
CONFIG_CIFS=y
