#!/bin/sh
#
# LayerCam service (BusyBox init).  Starts the camera software (which runs
# the Wi-Fi itself, layercam-net), and starts it again if it ever stops.
# Before each start the factory copy of layercam/update.py picks which copy
# of the software runs: an update on trial, the last good one, or the
# factory copy in /usr/share/layercam (README.md, Updates).  Not yet run on
# a board.
#

DIR=/usr/share/layercam            # the factory copy of the Python package (layercam/)
APPS=/userdata/layercam/app        # updates (layercam/update.py)
CONF=/userdata/layercam/layercam.ini
LOG=/var/log/layercam.log
PIDFILE=/var/run/layercam.pid

start() {
	printf "Starting layercam: "
	mkdir -p /userdata/layercam
	# Luckfox's default camera app holds the sensor; the SDK ships this script
	# for exactly that (luckfox_pico_rkmpi_example calls it too)
	[ -x /oem/usr/bin/RkLunch-stop.sh ] && /oem/usr/bin/RkLunch-stop.sh >/dev/null 2>&1
	command -v RkLunch-stop.sh >/dev/null 2>&1 && RkLunch-stop.sh >/dev/null 2>&1
	# the ESP32-C6's host driver (esp-hosted-linux, built out of tree:
	# README.md, Building the image).  The C6 must already hold esp-hosted's
	# firmware (tools/layercam-c6-flash.py); the mmc-pwrseq gives it 1.5 s
	# after EN, then the driver brings up wlan0
	if ! grep -q '^esp32_sdio ' /proc/modules 2>/dev/null; then
		for ko in /lib/modules/esp32_sdio.ko /oem/usr/ko/esp32_sdio.ko; do
			[ -f $ko ] && insmod $ko && break
		done
	fi
	# a supervisor loop: the service restarts itself after a settings change (exec),
	# exits with 3 to have a new version started, and this brings it back after a crash
	(
		while true; do
			RUN=$(cd $DIR && python3 -m layercam.update select --root $APPS --factory $DIR 2>>$LOG)
			[ -f "$RUN/layercam/__main__.py" ] || RUN=$DIR
			cd "$RUN" && python3 -m layercam --config $CONF >>$LOG 2>&1
			[ $? -eq 3 ] || sleep 5
		done
	) &
	echo $! > $PIDFILE
	echo "OK"
}

stop() {
	printf "Stopping layercam: "
	[ -f $PIDFILE ] && kill $(cat $PIDFILE) 2>/dev/null
	pkill -f "python3 -m layercam" 2>/dev/null
	pkill layercam-media 2>/dev/null
	rm -f $PIDFILE
	echo "OK"
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload) stop; sleep 1; start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit $?
