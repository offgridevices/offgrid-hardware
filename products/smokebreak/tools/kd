#!/bin/sh
# Run a command inside the pinned toolchain container (tools/Dockerfile),
# with the repository mounted at /w and the working directory carried over.
#   tools/kd python3 src/fab.py
# The repository root, at any folder depth.  In a git worktree the
# repository's own .git lives outside it: mount that too, at its own path,
# so git works inside the container (check_outputs.py reads HEAD).
ROOT=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
GIT=$(cd "$(git -C "$ROOT" rev-parse --git-common-dir)" && pwd)
case "$GIT" in "$ROOT"/*) GITMOUNT= ;; *) GITMOUNT="-v $GIT:$GIT" ;; esac
REL=$(pwd | sed "s|^$ROOT||")
SUDO=$( [ -w /var/run/docker.sock ] || echo sudo )
exec $SUDO docker run --rm -u "$(id -u):$(id -g)" -e HOME=/tmp -e PYTHONHASHSEED=0 \
  -v "$ROOT":/w $GITMOUNT -w "/w$REL" sbkicad:10 "$@"
