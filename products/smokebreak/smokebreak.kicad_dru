(version 1)
# Pads of one part sit as close as its maker made them (a 0.5 mm pitch
# controller has 60 V pins 0.22 mm apart): the HV class's clearance is for
# copper between parts.
(rule "pads within U1"
  (condition "A.memberOfFootprint('U1') && B.memberOfFootprint('U1')")
  (constraint clearance (min 0.09mm)))
(rule "pads within U3"
  (condition "A.memberOfFootprint('U3') && B.memberOfFootprint('U3')")
  (constraint clearance (min 0.09mm)))
(rule "pads within J8"
  (condition "A.memberOfFootprint('J8') && B.memberOfFootprint('J8')")
  (constraint clearance (min 0.09mm)))

(rule "plated hole to track"
  (condition "A.Type == 'Pad' && A.isPlated() && A.Pad_Type == 'Through-hole' && B.Type == 'Track'")
  (constraint hole_clearance (min 0.25mm)))
(rule "no other track across the sources copper"
  (condition "A.Type == 'Track' && A.NetName != 'SRC' && A.intersectsArea('sources')")
  (constraint disallow track))
(rule "no other track across the Q1 drain copper"
  (condition "A.Type == 'Track' && A.NetName != 'VIN' && A.intersectsArea('Q1 drain')")
  (constraint disallow track))
(rule "no other track across the battery minus copper"
  (condition "A.Type == 'Track' && A.NetName != 'BATT_NEG' && A.intersectsArea('battery minus')")
  (constraint disallow track))
(rule "no other track across the battery plus copper"
  (condition "A.Type == 'Track' && A.NetName != 'VBAT' && A.intersectsArea('battery plus')")
  (constraint disallow track))
(rule "no other track across the fuse load side copper"
  (condition "A.Type == 'Track' && A.NetName != 'VIN' && A.intersectsArea('fuse load side')")
  (constraint disallow track))
(rule "no other track across the Q2 drain copper"
  (condition "A.Type == 'Track' && A.NetName != 'VOUT' && A.intersectsArea('Q2 drain')")
  (constraint disallow track))
(rule "no other track across the Q11 sources copper"
  (condition "A.Type == 'Track' && A.NetName != 'GND' && A.intersectsArea('Q11 sources')")
  (constraint disallow track))
(rule "no other track across the shunt GND copper"
  (condition "A.Type == 'Track' && A.NetName != 'GND' && A.intersectsArea('shunt GND')")
  (constraint disallow track))
(rule "no other track across the drone negative copper"
  (condition "A.Type == 'Track' && A.NetName != 'DRONE_NEG' && A.NetName != 'VOUT' && A.NetName != 'VOUT_SNUB' && A.intersectsArea('drone negative')")
  (constraint disallow track))
