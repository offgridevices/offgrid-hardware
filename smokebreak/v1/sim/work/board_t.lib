* =====================================================================
* SmokeBreak v1 - board-level blocks built from smokebreak.lib
* =====================================================================

* ---------------------------------------------------------------------
* Main power path: input caps + damper + TVS, 1 mOhm shunt, Q1/Q2
* common-source, TPS48111 with TI gate-slew network (R1 on PU, PD direct,
* R2+C1 gate->GND), 15 V gate-source zener, CBST 2.2 uF.
*   pins: vin  (board input, battery +)
*         vsh  (shunt bottom = Q1 drain)
*         src  (common source)    gate
*         vout (drone side +)
*         pg   (power ground)     lgnd (controller / logic ground)
*         inp  (TPS48111 INP pin) scp (SCP latch flag, 0/1)
* ---------------------------------------------------------------------
.subckt PPATH vin vsh src gate vout pg lgnd inp scp params: cin=4.7u cesr=3m
+ cd=10u rd=0.33 vscp=80m tsc=1.16u tpd_inp=0.5u r1=100k c1=150n rsh=1m lsh=0.3n
* input ceramic bank (effective value at 60 V DC bias) and RC damper
Cin vin ci {cin}
Rci ci ci2 {cesr}
Lci ci2 pg 0.5n
Cdmp vin cdx {cd}
Rdmp cdx pg {rd}
XTVS vin pg TVS64CA
* shunt (Kelvin) with ESL
Rsh vin shx {rsh}
Lsh shx vsh {lsh}
* main switches
Vq1 vsh q1d 0
M1 q1d gate src QMAIN
Vq2 vout q2d 0
M2 q2d gate src QMAIN
* controller
Rvs vin vsf 100
Cvs vsf lgnd 100n
XC vsf lgnd inp vin vsh src pu pd bst scp TPS48111 vscp={vscp} tsc={tsc} tpd_inp={tpd_inp}
Cbst bst src 2.2u
R1 pu gate {r1}
Rpd pd gate 0.1
R2 gate c1x 10
C1 c1x lgnd {c1}
Dz src gate DZ15
.ends PPATH

* ---------------------------------------------------------------------
* Pre-charge: QP (P-FET, source at VIN) -> optional series Schottky
* (rbyp = 1m removes it, 1G keeps it) -> RPRE -> VOUT.
* Gate: 100k G-S, 12 V zener, level shifter QSIG + rdrv to LGND.
*   en: logic level referred to lgnd (3.3 V = on)
* ---------------------------------------------------------------------
.subckt PRECH vin vout lgnd en params: rpre=10 rbyp=1G rdrv=22k
MQP qd gp vin QPRE
Rgs vin gp 100k
Dzp gp vin DZ12
Rdrv gp ld {rdrv}
MLS ld en lgnd QSIG
Dpre qd rp DSCH100
Rbyp qd rp {rbyp}
Vipre rp rpx 0
Rpre rpx vout {rpre}
.ends PRECH

* ---------------------------------------------------------------------
* Aux OR + buck input, VIN/VOUT sense dividers with MCU pin clamps
*   aux load: buck drawing 0.25 W, UVLO 3.0 V
* ---------------------------------------------------------------------
.subckt AUXSENSE vin vout lgnd aux
Da1 vin ax D4148
Da2 vout ax D4148
Rax ax aux 10
Cax aux lgnd 1u
XAL aux lgnd CPLOAD pw=0.25 vuv=3.0
* VIN divider 1M / 51k (0..66 V -> 0..3.2 V)
Rvt vin adcv 1Meg
Rvb adcv lgnd 51k
Dv1 lgnd adcv DESD
* VOUT high divider
Rot vout adco 1Meg
Rob adco lgnd 51k
Do1 lgnd adco DESD
.ends AUXSENSE

* ---------------------------------------------------------------------
* 3 V probe: 3.0 V source, 1k path and 100R path (P-FET switches modelled
* as 2 Ohm switches + body diodes), 100 V Schottky into VOUT.
*   e1k / e100 : control (1 = on) referred to 0
*   vlo: VOUT low channel (10k + clamps to lgnd and 3.3 V)
* ---------------------------------------------------------------------
.subckt PROBE vout lgnd e1k e100 vlo params: vprobe=3.0
Vp3 p3 lgnd {vprobe}
S1 p3 n1 e1k 0 SWP
Db1 n1 p3 DESD
R1k n1 pj 1k
S2 p3 n2 e100 0 SWP
Db2 n2 p3 DESD
R100 n2 pj 100
Dps pj vout DSIG100
Rlo vout vlo 10k
Dlo1 lgnd vlo DESD
V33 v33 lgnd 3.3
Dlo2 vlo v33 DESD
Clo vlo lgnd 10n
.model SWP SW(Ron=2 Roff=1G Vt=0.5 Vh=0.1)
.ends PROBE
